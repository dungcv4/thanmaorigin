--- !u!114 &-7650876920114251327
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: -7079477642395098115}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 04f84fc2003509a5e7e068ec1271cc40, type: 3}
  m_Name: 
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.9960784912109375, g: 0.9215686917304993, b: 0.7333333492279053, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: db54bdfd5e27b744f86189fb263446bc, type: 3}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 16
    m_MaxSize: 18
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 当年采石矶一战后，五毒元气大伤，只得遁入岭南休养生息。教内人心惶惶之际，神秘西域女子古嫣然以铁血手腕夺得大权，号令五毒弟子于深山密林中重振旗鼓，六年后果然成为南方势力一霸。武林各势力对这重新崛起的五毒都讳莫如深，据传古教主与当今权势熏天的当朝宰相韩侂胄关系匪浅，更令人惊讶的是，雄踞江南的天王帮首领杨铁心与其私下也有来往，古嫣然高深莫测的背景令其在教中风头一时无二。而如今，实力强大的五毒终于决定踏足中原，重回江湖，势要夺回曾经失去的一切……
